{
  "name": "checkpoint",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "vector:gen": "pnpm --filter @checkpoint/shared vector:gen",
    "rules:hash": "pnpm --filter @checkpoint/guard rules:hash",
    "guard": "tsx packages/guard/src/cli.ts",
    "guard:dev": "pnpm --filter @checkpoint/guard dev",
    "agents:dev": "pnpm --filter @checkpoint/agents dev",
    "dev:services": "pnpm --parallel --filter @checkpoint/guard --filter @checkpoint/agents dev",
    "mock": "pnpm --filter @checkpoint/agents mock",
    "snapshot:check": "tsx packages/agents/src/snapshot-check.ts",
    "verify:audit": "tsx scripts/verify-audit.ts",
    "llm:check": "tsx scripts/llm-check.ts",
    "settle": "tsx scripts/settle.ts",
    "contracts:build": "bash scripts/contracts-build.sh",
    "contracts:test": "bash scripts/contracts-build.sh && cargo test --workspace",
    "vault:check": "tsx scripts/vault-views-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
